# SoloSafe v0.1 - local development only
# 실제 값이 들어간 .env 파일은 절대 커밋하지 않는다 (.gitignore 처리됨).

# --- PostgreSQL (local) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Application ---
# 예: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# pytest 전용 DB (운영/개발 DB와 반드시 다른 이름을 쓴다. 테스트 시작 시 스키마가 초기화된다)
TEST_DATABASE_URL=

# --- Auth (Step 3) ---
# 32자 이상 임의 문자열. 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
