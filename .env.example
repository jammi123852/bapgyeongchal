# SoloSafe v0.1 - local development only
# 실제 값이 들어간 .env 파일은 절대 커밋하지 않는다 (.gitignore 처리됨).

# --- PostgreSQL (local) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# --- Application ---
# 예: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# pytest 전용 DB (운영/개발 DB와 반드시 다른 이름을 쓴다. 테스트 시작 시 스키마가 초기화된다)
TEST_DATABASE_URL=

# --- Auth (Step 3) ---
# 32자 이상 임의 문자열. 생성 예: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 레시피 수집 (무료 키, scripts/import_recipes_*.py 에서만 사용)
# 식품안전나라 인증키 (COOKRCP01 조리식품 레시피): https://www.foodsafetykorea.go.kr 공공데이터활용 → 인증키 신청
FOODSAFETY_API_KEY=
# YouTube Data API v3 키: Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보
YOUTUBE_API_KEY=
